generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Nurse {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  shifts    Shift[]
}

model Shift {
  id        Int      @id @default(autoincrement())
  date      DateTime
  nurseId   Int
  nurse     Nurse    @relation(fields: [nurseId], references: [id])
  status    String   @default("requested") // requested, approved, denied
}
